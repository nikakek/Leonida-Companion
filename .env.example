# Leonida Companion environment variables.
# Copy to .env.local for local work; set the same names in your host's dashboard for production.
# Every variable is optional. If one is missing or malformed, the related feature renders nothing in
# production (and a dashed "Dev only" placeholder in development).
# NEXT_PUBLIC_* values are inlined at build time: redeploy after changing them.

# --- Site ---
# Public base URL, no trailing slash. Used for canonical URLs, sitemap.xml, robots.txt and share images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Public contact inbox shown on /privacy. Without it, the page points to the submission form instead.
NEXT_PUBLIC_CONTACT_EMAIL=
# Google Search Console "HTML tag" verification: paste only the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Affiliate links (shown on /deals only; must be full https:// URLs) ---
NEXT_PUBLIC_AFF_PSN_URL=
NEXT_PUBLIC_AFF_XBOX_URL=
NEXT_PUBLIC_AFF_SSD_URL=
NEXT_PUBLIC_AFF_DUALSENSE_URL=
NEXT_PUBLIC_AFF_XBOX_STORAGE_URL=

# --- Ads (Google AdSense) ---
# Publisher ID, e.g. ca-pub-1234567890123456. Alone, it loads the AdSense script (needed for site review
# and Auto ads) and generates /ads.txt.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit ID (digits only) of one responsive display unit. With both set, the labeled banner slots at the
# bottom of /cheats, /radio and /deals show ads.
NEXT_PUBLIC_ADSENSE_SLOT=
# Optional: full ads.txt content for other or additional ad networks. Overrides the generated Google line.
# One line per seller; separate lines with \n, e.g. "google.com, pub-123, DIRECT, f08c47fec0942fa0\nexample.com, 42, RESELLER"
ADS_TXT=

# --- Analytics (optional, choose one; production only) ---
# Plausible: the domain registered in Plausible (e.g. example.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Plausible: only if your dashboard gives you a different script URL than https://plausible.io/js/script.js
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=
# Umami: script URL and website ID
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Submissions (server-only, read at request time) ---
# "Submit a Discovery" entries are POSTed here as JSON. Never auto-published. Without it they are only logged.
SUBMISSION_WEBHOOK_URL=
# Upstash Redis REST credentials for the submission rate limit (5 per 10 minutes per IP).
# Without both, the limit is kept in memory per server instance (best-effort on serverless).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
