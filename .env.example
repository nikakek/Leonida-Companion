# Leonida Companion environment variables.
# Copy to .env.local and fill in. Every variable is optional: if one is missing,
# the related component renders nothing in production (and a dev-only placeholder
# in development).

# Public base URL, used for metadataBase, canonical URLs, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Affiliate links (used on /deals only) ---
NEXT_PUBLIC_AFF_PSN_URL=
NEXT_PUBLIC_AFF_XBOX_URL=
NEXT_PUBLIC_AFF_SSD_URL=
NEXT_PUBLIC_AFF_DUALSENSE_URL=
NEXT_PUBLIC_AFF_XBOX_STORAGE_URL=

# --- Ads ---
# Set to "true" to render reserved, labeled ad slots (max one per page). No ad network script ships in this build;
# a consent platform (CMP) must be wired in before any ad script loads for EU/UK visitors.
NEXT_PUBLIC_ADS_ENABLED=false

# --- Analytics (optional, choose one) ---
# Plausible: the domain registered in Plausible (e.g. example.com)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Umami: script URL and website ID
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# --- Submissions (server-only) ---
# Submissions from "Submit a Discovery" are forwarded here (POST JSON). Never auto-published.
SUBMISSION_WEBHOOK_URL=
